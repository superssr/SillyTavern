# Render.com 环境变量配置示例
# 复制此文件为 .env 并填入你的配置

# 服务器设置
NODE_ENV=production
LISTEN=true
PORT=10000
WHITELIST=false

# 基础认证（强烈推荐启用）
BASIC_AUTH=true
BASIC_AUTH_USER=你的用户名
BASIC_AUTH_PASSWORD=你的密码

# 可选：禁用不必要的功能以节省资源
AVOID_LOCAL_MODELS=true
DISABLE_EXTENSIONS=false
AUTO_UPDATE=false

# AI 服务配置（根据需要填写）
# OpenAI
# OPENAI_API_KEY=sk-xxx

# Claude (Anthropic)
# CLAUDE_API_KEY=sk-ant-xxx

# Google AI
# GOOGLE_API_KEY=xxx

# 其他 API 配置
# NOVEL_API_KEY=xxx
# KOBOLD_API_URL=http://localhost:5000